{
  "manifest_version": 3,
  "name": "blarg",
  "version": "1.0",
  "description": "filter against slop",
  "host_permissions": [
    "https://api.twitter.com/*",
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "permissions": ["storage", "webRequest"],
  "action": {
    "default_popup": "src/popover.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": [
        "src/compare.js",
        "src/reaction.js",
        "src/twitter.js",
        "src/storage.js",
        "src/main.js"
      ],
      "css": ["src/style.css"]
    }
  ]
}
