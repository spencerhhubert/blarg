{
  "manifest_version": 3,
  "name": "blarg",
  "version": "1.0",
  "description": "filter posts with random trash can insertion",
  "action": {
    "default_popup": "src/popup.html"
  },
  "host_permissions": ["<all_urls>"],
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/store.js", "src/openai.js", "src/main.js"],
      "css": ["src/style.css"],
      "run_at": "document_end"
    }
  ]
}
